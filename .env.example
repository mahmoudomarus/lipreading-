# Process settings only; no automatic .env loader. Never put real keys in Git.
# Defaults use the included hosted adapter; replace with your endpoint/model.
AGENT_PROTOCOL=responses
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-6.1-sol
AGENT_MAX_CONCURRENT_JOBS=3
# AGENT_API_KEY=
# OPENAI_API_KEY=  # Legacy fallback for the unchanged default endpoint only
AGENT_VOICE_MODEL=gpt-realtime-2.1-mini
LIPREAD_DEVICE=cpu
LIPREAD_THREADS=4
LIPREAD_BEAM=12
LIPREAD_FAST_BEAM=4
LIPREAD_CACHE_DETECTIONS=1
# LIPREAD_SITE_ORIGIN=https://your-static-frontend.example
# MPLCONFIGDIR=  # Launcher defaults to .runtime/matplotlib
# XDG_CACHE_HOME=  # Launcher defaults to .runtime/cache
